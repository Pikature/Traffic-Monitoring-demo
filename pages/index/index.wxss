/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.traffic-card {
  margin: 24rpx;
  padding: 28rpx 32rpx 44rpx;
  border: 1rpx solid #ececf0;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.card-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f1f24;
  line-height: 1.45;
}

.time-range {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding-top: 8rpx;
  font-size: 22rpx;
  color: #9a9aa0;
}

.metrics {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.metric {
  margin-right: 24rpx;
  font-size: 23rpx;
  color: #7c7c82;
}

ec-canvas {
  display: block;
  width: 100%;
  height: 720rpx;
  margin-top: 24rpx;
}
