<!--index.wxml-->
<navigation-bar title="流量监控" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="traffic-card">
    <view class="card-header">
      <text class="card-title">{{deviceTitle}}</text>
      <text class="time-range">{{timeRangeText}}</text>
    </view>
    <view class="metrics">
      <text class="metric">接入带宽：{{bandwidthText}}</text>
      <text class="metric">当前水位：{{currentLevel}}%</text>
      <text class="metric">昨日水位：{{yesterdayLevel}}%</text>
    </view>
    <ec-canvas id="trafficChart" canvas-id="traffic-chart" ec="{{ ec }}"></ec-canvas>
  </view>
</scroll-view>
